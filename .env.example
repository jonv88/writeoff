# Public Supabase keys only — never put service_role here or commit real secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional alias (either anon or publishable key works with the client)
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Receipt OCR: your server/edge function URL (provider secrets stay server-side).
# Without this, Snap a receipt still opens — extraction is blocked and manual entry is used.
# VITE_OCR_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/extract-receipt
# VITE_OCR_AUTH_TOKEN=

# Apply migrations from supabase/migrations/ to your Writeoff project before signing in.
