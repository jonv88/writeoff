# =============================================================================
# Browser / Vite — PUBLIC ONLY
# Never put service_role, MINDEE_API_KEY, or other OCR secrets in VITE_* vars.
# =============================================================================
VITE_SUPABASE_URL=https://YOUR_WRITEOFF_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# VITE_SUPABASE_PUBLISHABLE_KEY=

# The extract-receipt Edge Function URL is derived automatically:
#   ${VITE_SUPABASE_URL}/functions/v1/extract-receipt
# The browser sends the customer JWT; provider keys stay on the server.

# =============================================================================
# Server / Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets)
# Also used by scripts/verify-receipt-flow.mjs when testing with a service role
# (service role must NEVER be committed or put in VITE_*).
# =============================================================================
# OCR_PROVIDER=mindee
# MINDEE_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server/scripts only — never Vite

# Apply migrations (see docs/APPLY_MIGRATIONS.md) before signing in.
