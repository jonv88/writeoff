# Browser / Vite — public only. Never put a service-role key in a VITE_ name.
# Set these on the private preview after the Writeoff project exists.
# See docs/APPLY_MIGRATIONS.md. Do not point them at Rhev.
VITE_SUPABASE_URL=https://YOUR_WRITEOFF_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# VITE_SUPABASE_ANON_KEY=

# Server only. The billing webhook uses this to store entitlements.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode only. sk_live_ is refused.
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_PRICE_ID=price_
# STRIPE_WEBHOOK_SECRET=whsec_
# STRIPE_PRODUCT_ID=writeoff-sandbox

# Optional bank sandbox, server only. Production is refused.
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# BANK_TOKEN_KEY=  # 32 random bytes, base64 encoded; keep stable for token decryption
# WRITEOFF_APP_ORIGIN=https://your-private-preview.vercel.app
